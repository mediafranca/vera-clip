-- allium: 3
-- browser-compatibility.allium
--
-- Scope: Garantizar el mismo recorrido esencial de Vera Clip en Chrome, Edge,
-- Brave y Firefox.
-- Includes: navegadores admitidos, instalación disponible y paridad funcional.
-- Excludes: versiones mínimas y Safari/WebKit.

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum NavegadorAdmitido { chrome | edge | brave | firefox }
enum MotorDeNavegador { chromium | gecko }

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity DistribucionDeExtension {
    navegador: NavegadorAdmitido
    motor: MotorDeNavegador
    instalable: Boolean
    captura_seleccion: Boolean
    captura_articulo: Boolean
    previsualizacion: Boolean
    entrega: Boolean
    gestion_de_pendientes: Boolean
    boton_del_navegador: Boolean
    menu_contextual: Boolean
    canal: directa

    recorrido_esencial_completo:
        instalable
        and captura_seleccion
        and captura_articulo
        and previsualizacion
        and entrega
        and gestion_de_pendientes
        and boton_del_navegador
        and menu_contextual
}

entity PaginaDeDescarga {
    explica_ausencia_de_tiendas: Boolean
    ofrece_chromium_actual: Boolean
    ofrece_firefox_actual: Boolean
    instrucciones_chromium: Boolean
    instrucciones_firefox: Boolean
    enlaza_codigo_fuente: Boolean

    completa:
        explica_ausencia_de_tiendas
        and ofrece_chromium_actual
        and ofrece_firefox_actual
        and instrucciones_chromium
        and instrucciones_firefox
        and enlaza_codigo_fuente
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule PublicarDistribucionAdmitida {
    when: EquipoPublicaExtension(navegador, motor)
    requires: navegador in {chrome, edge, brave, firefox}
    requires: navegador in {chrome, edge, brave} implies motor = chromium
    requires: navegador = firefox implies motor = gecko
    ensures: DistribucionDeExtension.created(
        navegador: navegador,
        motor: motor,
        instalable: true,
        captura_seleccion: true,
        captura_articulo: true,
        previsualizacion: true,
        entrega: true,
        gestion_de_pendientes: true
        boton_del_navegador: true
        menu_contextual: true
        canal: directa
    )
}

rule PublicarPaginaDeDescarga {
    when: EquipoPublicaPaginaDeDescarga()
    ensures: PaginaDeDescarga.created(
        explica_ausencia_de_tiendas: true,
        ofrece_chromium_actual: true,
        ofrece_firefox_actual: true,
        instrucciones_chromium: true,
        instrucciones_firefox: true,
        enlaza_codigo_fuente: true
    )
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant ParidadDelRecorridoEsencial {
    DistribucionesDeExtension.all(d => d.recorrido_esencial_completo)
}

invariant MotorCorrespondeAlNavegador {
    DistribucionesDeExtension.all(d =>
        (d.navegador in {chrome, edge, brave} implies d.motor = chromium)
        and (d.navegador = firefox implies d.motor = gecko)
    )
}

invariant TodaPaginaDeDescargaEsCompleta {
    PaginasDeDescarga.all(p => p.completa)
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor EquipoDeVeraClip {
    identified_by: DistribucionDeExtension
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface PublicacionDeExtension {
    facing equipo: EquipoDeVeraClip

    provides:
        EquipoPublicaExtension(navegador, motor)
        EquipoPublicaPaginaDeDescarga()

    exposes:
        DistribucionesDeExtension
        PaginasDeDescarga

    @guarantee MismosGestosEsenciales
        -- Una persona puede capturar, revisar, enviar y gestionar pendientes
        -- del mismo modo en Chrome, Edge, Brave y Firefox. Las diferencias de
        -- manifiesto o APIs no eliminan capacidades del recorrido esencial.

    @guarantee SinDependenciaDeTiendas
        -- El proyecto produce dos paquetes instalables directamente: uno para
        -- Chromium y otro para Firefox. Ninguno se publica ni se descubre en
        -- Chrome Web Store, Edge Add-ons o el catálogo público de AMO. La firma
        -- unlisted que Firefox estable exige no convierte AMO en canal de
        -- distribución: el XPI firmado se entrega por medios propios.

    @guarantee DescargaVerificableYActual
        -- La página pública explica la decisión, enseña a instalar cada
        -- paquete y enlaza los artefactos de la publicación más reciente en
        -- GitHub Releases junto con el código fuente.
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "¿Qué versiones mínimas de Chrome, Edge, Brave y Firefox se sostendrán en el primer lanzamiento?"
